# ============================================================
# Hub do Artista — Back-end (server) — EXEMPLO de variáveis
# Copie para `.env` e preencha com valores reais. NUNCA commite o .env.
# ============================================================

PORT=3000

# URL do projeto Supabase (ex: https://xxxxx.supabase.co)
SUPABASE_URL=

# CHAVE DE SERVIÇO (service role) — obrigatória no servidor.
# Formato novo do Supabase: sb_secret_...
# (equivalente antigo: service_role key). Ignora RLS e permite inserir
# na tabela usuarios e usar o admin API. NUNCA colocar no front-end.
SUPABASE_SERVICE_ROLE_KEY=
# Compatibilidade (alternativa ao nome acima):
# SUPABASE_KEY=

# Domínio do front-end para CORS e redirects de e-mail
CLIENT_URL=http://localhost:5173

# ============================================================
# WhatsApp API (opcional — fallback para e-mail via Nodemailer)
# ============================================================
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ============================================================
# SMTP (fallback de notificações de agendamento)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
DEFAULT_NOTIFICATION_EMAIL=contato@exemplo.com
