# ============================================================
# Hub do Artista — Front-end (client) — EXEMPLO de variáveis
# Copie para `.env` e preencha com valores reais. NUNCA commite o .env.
# ============================================================

# URL do projeto Supabase (ex: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# CHAVE PÚBLICA (anon) — a ÚNICA permitida no front-end.
# Formato novo do Supabase: sb_publishable_...
# (equivalente antigo: anon key). NUNCA use a chave de serviço
# (sb_secret_...) aqui — ela expõe acesso total ao banco no navegador.
VITE_SUPABASE_ANON_KEY=

# URL da API do back-end
VITE_API_URL=http://localhost:3000/api
